// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  name                     String?
  firstName                String?
  lastName                 String?
  userName                 String?                   @unique
  email                    String                    @unique
  emailVerified            DateTime?
  image                    String?
  location                 String?
  password                 String?
  profilePicture           String?
  identityVerified         Boolean                   @default(false)
  contactVerified          Boolean                   @default(false)
  nidVerified              Boolean                   @default(false)
  addressVerified          Boolean                   @default(false)
  meetupVerified           Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  accounts                 Account[]
  sessions                 Session[]
  authenticators           Authenticator[]
  lentItems                LentItem[]
  mentorBookings           MentorBooking[]
  borrows                  BorrowTransaction[]       @relation("Borrower")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  cartItems                CartItem[]
  trailEntries             ItemTrailEntry[]
  trailReactions           TrailReaction[]
  cartSessions             CartSession[]
  billingOrders            BillingOrder[]            @relation("BorrowerOrders")
  borrowOrders             BorrowOrder[]             @relation("BorrowOrderBorrower")
  lentOrders               BorrowOrder[]             @relation("BorrowOrderLender")
  notifications            Notification[]
}

model Product {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  category          String
  location          String
  postedAt          DateTime
  priceAmount       Int
  summary           String
  description       String            @db.Text
  features          Json
  imageUrl          String
  lenderName        String
  lenderRating      Decimal           @db.Decimal(2, 1)
  lenderNote        String            @db.Text
  compensationMajor String
  compensationMinor String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  billingOrders     BillingOrder[]
  trailEntries      ItemTrailEntry[]
  cartItems         ProductCartItem[]
}

model LentItem {
  id          String   @id @default(cuid())
  lenderId    String
  title       String
  description String?  @db.Text
  imageUrl    String?
  category    String?
  location    String?
  pricePerDay Int?
  deposit     Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lender       User                @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  borrows      BorrowTransaction[]
  cartItems    CartItem[]
  trailEntries ItemTrailEntry[]
  borrowOrders BorrowOrder[]

  @@index([lenderId])
}

model ProductPc {
  id                String   @id
  name              String
  postedAt          DateTime @default(now())
  location          String?
  images            String   @db.LongText
  description       String
  features          String   @db.LongText
  lenderName        String
  lenderReview      Float
  lenderNote        String
  lenderInfoUrl     String?
  compensationMajor String
  compensationMinor String
  category          String?

  @@map("productpc")
}

enum BillingMethod {
  BKASH
  NAGAD
  ROCKET
  CARD
  CASH_ON_DELIVERY
}

model BillingOrder {
  id              String        @id @default(cuid())
  productId       String
  borrowerId      String?
  fullName        String
  email           String
  phoneNumber     String
  deliveryAddress String        @db.Text
  specialNotes    String?       @db.Text
  billingMethod   BillingMethod
  createdAt       DateTime      @default(now())

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  borrower User?   @relation("BorrowerOrders", fields: [borrowerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([borrowerId])
}

// ── Borrow Orders (lent-item checkout) ───────────────────────────────────────

model BorrowOrder {
  id         String    @id @default(cuid())
  borrowerId String
  lenderId   String
  lentItemId String
  startDate  DateTime?
  endDate    DateTime?
  status     String    @default("pending")
  totalPrice Int?
  deposit    Int?
  notes      String?   @db.Text
  returnedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  borrower   User            @relation("BorrowOrderBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  lender     User            @relation("BorrowOrderLender", fields: [lenderId], references: [id], onDelete: Cascade)
  lentItem   LentItem        @relation(fields: [lentItemId], references: [id], onDelete: Cascade)
  trailEntry ItemTrailEntry?

  @@index([borrowerId])
  @@index([lenderId])
  @@index([lentItemId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Mentor System ─────────────────────────────────────────────────────────────

model Mentor {
  id              String   @id @default(cuid())
  name            String
  handle          String   @unique
  avatar          String
  specialty       String
  category        String
  bio             String   @db.Text
  tags            Json
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  sessions        Int      @default(0)
  pricePerSession Int
  available       Boolean  @default(true)
  responseTime    String
  createdAt       DateTime @default(now())

  bookings MentorBooking[]
}

enum SessionFormat {
  VIDEO
  IN_PERSON
}

model MentorBooking {
  id            String        @id @default(cuid())
  mentorId      String
  userId        String
  sessionFormat SessionFormat @default(VIDEO)
  scheduledAt   DateTime?
  goals         String?       @db.Text
  status        String        @default("pending")
  createdAt     DateTime      @default(now())

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([userId])
}

// ── Borrow Transactions ───────────────────────────────────────────────────────

enum BorrowStatus {
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

model BorrowTransaction {
  id            String       @id @default(cuid())
  lentItemId    String
  borrowerId    String
  startDate     DateTime
  endDate       DateTime
  returnedAt    DateTime?
  status        BorrowStatus @default(ACTIVE)
  depositAmount Int
  totalPrice    Int
  damageReport  Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lentItem   LentItem        @relation(fields: [lentItemId], references: [id], onDelete: Cascade)
  borrower   User            @relation("Borrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  trailEntry ItemTrailEntry?

  @@index([lentItemId])
  @@index([borrowerId])
}

// ── Messaging ─────────────────────────────────────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ── Cart ──────────────────────────────────────────────────────────────────────

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  lentItemId String
  days       Int      @default(1)
  addedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lentItem LentItem @relation(fields: [lentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, lentItemId])
  @@index([userId])
}

// ── NextAuth ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String  @db.Text
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ── Social Item Trail ─────────────────────────────────────────────────────────

model ItemTrailEntry {
  id            String  @id @default(cuid())
  productId     String?
  lentItemId    String?
  borrowId      String? @unique
  borrowOrderId String? @unique
  borrowerId    String?

  useFor     String   @db.Text
  location   String?
  tags       Json     @default("[]")
  itemRating Int
  photoUrls  Json     @default("[]")
  isPublic   Boolean  @default(true)
  anonymous  Boolean  @default(false)
  createdAt  DateTime @default(now())

  product     Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  lentItem    LentItem?          @relation(fields: [lentItemId], references: [id], onDelete: Cascade)
  borrow      BorrowTransaction? @relation(fields: [borrowId], references: [id])
  borrowOrder BorrowOrder?       @relation(fields: [borrowOrderId], references: [id])
  borrower    User?              @relation(fields: [borrowerId], references: [id])
  reactions   TrailReaction[]

  @@index([productId])
  @@index([lentItemId])
  @@index([borrowerId])
}

model TrailReaction {
  id           String   @id @default(cuid())
  trailEntryId String
  userId       String
  type         String   @default("heart")
  createdAt    DateTime @default(now())

  trailEntry ItemTrailEntry @relation(fields: [trailEntryId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trailEntryId, userId])
  @@index([trailEntryId])
  @@index([userId])
}

// ── Product Cart (session-based) ──────────────────────────────────────────────

model CartSession {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ProductCartItem[]

  @@index([token])
  @@index([userId])
}

model ProductCartItem {
  id            String    @id @default(cuid())
  cartSessionId String
  productId     String
  days          Int       @default(1)
  startDate     DateTime?
  endDate       DateTime?
  addedAt       DateTime  @default(now())

  cartSession CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartSessionId, productId])
  @@index([cartSessionId])
}
