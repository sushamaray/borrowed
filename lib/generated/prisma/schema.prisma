// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  name             String?
  firstName        String?
  lastName         String?
  userName         String?   @unique
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  location         String?
  latitude         Float?
  longitude        Float?
  password         String?
  profilePicture   String?
  phoneNumber      String?
  identityVerified Boolean   @default(false)
  contactVerified  Boolean   @default(false)
  idVerified       Boolean   @default(false)
  addressVerified  Boolean   @default(false)
  meetupVerified   Boolean   @default(false)
  verifiedAt       DateTime?
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  accounts                 Account[]
  sessions                 Session[]
  authenticators           Authenticator[]
  products                 Product[]                 @relation("ProductCreator")
  lentItems                LentItem[]
  mentor                   Mentor?
  mentorBookings           MentorBooking[]
  checkoutsAsBorrower      BorrowCheckout[]          @relation("CheckoutBorrower")
  checkoutsAsLender        BorrowCheckout[]          @relation("CheckoutLender")
  borrowRequests           BorrowRequest[]
  borrowRequestOffers      BorrowRequestOffer[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  cartItems                CartItem[]
  trailEntries             ItemTrailEntry[]
  trailReactions           TrailReaction[]
  lenderReviews            BorrowerReview[]          @relation("LenderReviews")
  borrowerReviews          BorrowerReview[]          @relation("BorrowerReviews")
  reportsMade              UserReport[]              @relation("ReportsMade")
  reportsReceived          UserReport[]              @relation("ReportsReceived")
  notifications            Notification[]
  idVerification           IdVerification?
  disputesRaised           Dispute[]                 @relation("DisputeRaisedBy")
  disputesAsBorrower       Dispute[]                 @relation("DisputeBorrower")
  disputesAsLender         Dispute[]                 @relation("DisputeLender")
  disputeResolutions       DisputeResolution[]       @relation("DisputeResolvedBy")
}

// ── Product — central item info store ────────────────────────────────────────
// Created when a lender lists an item OR when a lender responds to a borrow
// request. One Product can back multiple LentItem rows over time (reuse).

model Product {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  category          String
  subcategory       String?
  location          String
  pricePerDay       Int
  deposit           Int?
  description       String         @db.Text
  features          Json           @default("[]")
  drawbacks         Json           @default("[]")
  imageUrl          String?
  images            ProductImage[]
  compensationMajor String?
  compensationMinor String?
  lenderNote        String?        @db.Text
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  createdBy    User                 @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lentItems    LentItem[]
  offers       BorrowRequestOffer[]
  checkouts    BorrowCheckout[]
  trailEntries ItemTrailEntry[]

  @@index([createdById])
  @@index([category])
}

// ── ProductImage — multiple images per product ────────────────────────────────

model ProductImage {
  id        String @id @default(cuid())
  productId String
  data      Bytes  @db.LongBlob
  mimeType  String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── ConditionPhoto — before/after borrow condition images ────────────────────

model ConditionPhoto {
  id         String   @id @default(cuid())
  checkoutId String
  role       String // "before" | "after"
  data       Bytes    @db.LongBlob
  mimeType   String
  createdAt  DateTime @default(now())

  checkout BorrowCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
}

// ── LentItem — Side A listing ────────────────────────────────────────────────
// A lender makes a product available for borrowing. One product can be relisted
// multiple times after being returned (only one active/borrowed at a time).

model LentItem {
  id        String   @id @default(cuid())
  productId String
  lenderId  String
  status    String   @default("active") // "active" | "borrowed" | "inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  lender       User             @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  checkouts    BorrowCheckout[]
  trailEntries ItemTrailEntry[]

  @@index([lenderId])
  @@index([productId])
}

// ── BorrowRequest — Side B want-ad ───────────────────────────────────────────
// A borrower posts "I need X item". Lenders browse and respond with offers.

model BorrowRequest {
  id           String   @id @default(cuid())
  requesterId  String
  title        String
  category     String?
  description  String?  @db.Text
  location     String?
  neededFrom   DateTime
  neededUntil  DateTime
  budgetPerDay Int?
  status       String   @default("open") // "open" | "fulfilled" | "closed"
  isPrivate    Boolean  @default(false)
  targetUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  offers    BorrowRequestOffer[]

  @@index([requesterId])
  @@index([status])
}

// ── BorrowRequestOffer — Side B lender response ───────────────────────────────
// A lender responds to a BorrowRequest. They pick an existing Product or fill
// the listing form to create a new one. Borrower accepts one offer → BorrowCheckout.

model BorrowRequestOffer {
  id              String   @id @default(cuid())
  borrowRequestId String
  productId       String
  lenderId        String
  message         String?  @db.Text
  status          String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt       DateTime @default(now())

  borrowRequest BorrowRequest   @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lender        User            @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  checkout      BorrowCheckout?

  @@index([borrowRequestId])
  @@index([lenderId])
}

// ── BorrowCheckout — unified transaction ──────────────────────────────────────
// The agreed borrowing between two parties. Created from either flow.
// Side A: cart checkout of a LentItem  →  lentItemId set, borrowRequestOfferId null
// Side B: borrower accepts an offer    →  borrowRequestOfferId set, lentItemId null

model BorrowCheckout {
  id                   String    @id @default(cuid())
  borrowerId           String
  lenderId             String
  productId            String
  lentItemId           String?
  borrowRequestOfferId String?   @unique
  originType           String // "lent_item" | "borrow_request"
  startDate            DateTime?
  endDate              DateTime?
  totalPrice           Int?
  deposit              Int?
  notes                String?   @db.Text
  damageReport         Json?
  returnedAt           DateTime?
  cancelledBy          String? // "borrower" | "lender"
  status               String    @default("pending")
  // "pending" | "accepted" | "active" | "returned" | "rejected" | "cancelled"
  aiDamageVerdict      String? // "damaged" | "no_damage" | "unclear"
  aiDamageConfidence   Float?
  aiDamageNotes        String?   @db.Text
  aiDamageCheckedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  borrower        User                @relation("CheckoutBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  lender          User                @relation("CheckoutLender", fields: [lenderId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  lentItem        LentItem?           @relation(fields: [lentItemId], references: [id], onDelete: SetNull)
  offer           BorrowRequestOffer? @relation(fields: [borrowRequestOfferId], references: [id], onDelete: SetNull)
  trailEntry      ItemTrailEntry?
  borrowerReview  BorrowerReview?
  dispute         Dispute?
  conditionPhotos ConditionPhoto[]

  @@index([borrowerId])
  @@index([lenderId])
  @@index([productId])
  @@index([lentItemId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Mentor System ─────────────────────────────────────────────────────────────

model Mentor {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  handle          String   @unique
  avatar          String
  specialty       String
  category        String
  subcategories   Json     @default("[]")
  bio             String   @db.Text
  tags            Json
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  sessions        Int      @default(0)
  pricePerSession Int
  available       Boolean  @default(true)
  responseTime    String
  createdAt       DateTime @default(now())

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings MentorBooking[]
}

enum SessionFormat {
  VIDEO
  IN_PERSON
}

model MentorBooking {
  id            String        @id @default(cuid())
  mentorId      String
  userId        String
  sessionFormat SessionFormat @default(VIDEO)
  scheduledAt   DateTime?
  goals         String?       @db.Text
  status        String        @default("pending")
  createdAt     DateTime      @default(now())

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([userId])
}

// ── Messaging ─────────────────────────────────────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  type           String    @default("text")
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ── Cart (lent items only) ────────────────────────────────────────────────────

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  lentItemId String
  days       Int      @default(1)
  addedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lentItem LentItem @relation(fields: [lentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, lentItemId])
  @@index([userId])
}

// ── NextAuth ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String  @db.Text
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ── Social Item Trail ─────────────────────────────────────────────────────────

model ItemTrailEntry {
  id               String   @id @default(cuid())
  productId        String?
  lentItemId       String?
  borrowCheckoutId String?  @unique
  borrowerId       String?
  useFor           String   @db.Text
  location         String?
  tags             Json     @default("[]")
  itemRating       Int
  photoUrls        Json     @default("[]")
  isPublic         Boolean  @default(true)
  anonymous        Boolean  @default(false)
  createdAt        DateTime @default(now())

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lentItem       LentItem?       @relation(fields: [lentItemId], references: [id], onDelete: Cascade)
  borrowCheckout BorrowCheckout? @relation(fields: [borrowCheckoutId], references: [id], onDelete: SetNull)
  borrower       User?           @relation(fields: [borrowerId], references: [id])
  reactions      TrailReaction[]

  @@index([productId])
  @@index([lentItemId])
  @@index([borrowerId])
}

model TrailReaction {
  id           String   @id @default(cuid())
  trailEntryId String
  userId       String
  type         String   @default("heart")
  createdAt    DateTime @default(now())

  trailEntry ItemTrailEntry @relation(fields: [trailEntryId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trailEntryId, userId])
  @@index([trailEntryId])
  @@index([userId])
}

// ── Borrower Reviews (lender rates borrower after return) ─────────────────────

model BorrowerReview {
  id               String   @id @default(cuid())
  borrowCheckoutId String   @unique
  lenderId         String
  borrowerId       String
  rating           Int
  comment          String?  @db.Text
  createdAt        DateTime @default(now())

  borrowCheckout BorrowCheckout @relation(fields: [borrowCheckoutId], references: [id])
  lender         User           @relation("LenderReviews", fields: [lenderId], references: [id])
  borrower       User           @relation("BorrowerReviews", fields: [borrowerId], references: [id])

  @@index([lenderId])
  @@index([borrowerId])
}

// ── User Reports ──────────────────────────────────────────────────────────────

model UserReport {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  description    String?  @db.Text
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  readByAdmin Boolean @default(false)

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id])
  reported User @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([reportedUserId])
  @@index([reporterId])
  @@index([status])
}

// ── ID Verification ───────────────────────────────────────────────────────────

model IdVerification {
  id             String    @id @default(cuid())
  userId         String    @unique
  frontImage     Bytes?    @db.LongBlob
  backImage      Bytes?    @db.LongBlob
  selfieImage    Bytes?    @db.LongBlob
  frontMimeType  String?
  backMimeType   String?
  selfieMimeType String?
  faceMatchScore Float?
  status         String    @default("pending")
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Disputes ──────────────────────────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
}

enum DecisionType {
  RELEASE_TO_LENDER
  RETURN_TO_BORROWER
  SPLIT
}

model Dispute {
  id             String        @id @default(cuid())
  checkoutId     String        @unique
  raisedById     String
  borrowerId     String
  lenderId       String
  status         DisputeStatus @default(OPEN)
  title          String
  description    String        @db.Text
  depositAmount  Int
  beforePhotoUrl String?
  afterPhotoUrl  String?
  aiVerdict      String?
  aiConfidence   Float?
  aiNotes        String?       @db.Text
  raisedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  checkout   BorrowCheckout     @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  raisedBy   User               @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  borrower   User               @relation("DisputeBorrower", fields: [borrowerId], references: [id])
  lender     User               @relation("DisputeLender", fields: [lenderId], references: [id])
  resolution DisputeResolution?
  events     DisputeEvent[]

  @@index([status])
  @@index([raisedAt])
  @@index([borrowerId])
  @@index([lenderId])
}

model DisputeResolution {
  id               String       @id @default(cuid())
  disputeId        String       @unique
  resolvedById     String
  decisionType     DecisionType
  amountToLender   Int?
  amountToBorrower Int?
  justification    String       @db.Text
  resolvedAt       DateTime     @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  resolvedBy User    @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
}

model DisputeEvent {
  id        String   @id @default(cuid())
  disputeId String
  actorRole String
  type      String
  body      String?  @db.Text
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}
